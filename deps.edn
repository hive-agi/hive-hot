{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
        org.clojure/core.async {:mvn/version "1.9.865"}
        io.github.hive-agi/hive-events
        {:mvn/version "0.5.19"}
        io.github.hive-agi/hive-help {:mvn/version "0.1.6"}}

 :aliases
 {:build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.28"}}
          :ns-default hive-build.api}

  :dev {:extra-paths ["dev" "test"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                     ;; For local dev, override with local hive-events
                     io.github.hive-agi/hive-events {:mvn/version "0.5.19"}}}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; reg-hot-schema validates opts via hive-spi's
                      ;; schema.derive/compile-op; tests exercise that path
                      ;; (invalid opts must throw :schema/invalid).
                      io.github.hive-agi/hive-spi {:mvn/version "1.4.4"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test {:mvn/version "0.4.11"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  :nrepl {:main-opts ["-m" "nrepl.cmdline"
                      "--port" "7930"
                      "--interactive"]}}}
